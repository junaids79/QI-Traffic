# Copy to .env for local configuration; never commit real secrets.
FLASK_SECRET_KEY=replace-with-a-random-secret
FLASK_DEBUG=0
PORT=5000
# Optional provider credentials. The application remains in simulation mode when unset.
TRAFFIC_API_KEY=
MAP_API_KEY=
# Optional generic adapter endpoint. It must return {"edges":[{"source","destination","traffic_level","current_speed"}]}
TRAFFIC_API_URL=
